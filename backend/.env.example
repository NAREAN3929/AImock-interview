# Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values before deploying.

# MySQL Connection Details (Optional if using default SQLite fallback)
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_mock_interview

# Optional: Full Database URL override (e.g. for Render, Railway, AWS RDS)
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview # Options: gemini-3-flash-preview, gemini-3.1-flash-lite, gemini-flash-latest

# Security JWT Secret
SECRET_KEY=your_production_secret_jwt_key_here
