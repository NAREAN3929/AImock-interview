# ==============================================================================
# AI Mock Interview Platform — Environment Configuration Template
# ==============================================================================
# IMPORTANT: DO NOT commit real secrets or production keys into version control.
# Copy this file to .env and supply your environment-specific credentials.

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL / Cloud Database)
# ------------------------------------------------------------------------------
# Default local setup uses MySQL. If MySQL is unreachable, the system automatically
# falls back to local SQLite (interview_app.db) for zero downtime.
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_mock_interview

# Optional: Direct database connection string (e.g. for Render, Railway, AWS RDS, Supabase)
# DATABASE_URL=mysql+pymysql://user:password@host:3306/ai_mock_interview

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_production_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. Frontend & CORS Configuration (For Deployments)
# ------------------------------------------------------------------------------
# Set the backend URL for the frontend Vite build (e.g., https://your-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
